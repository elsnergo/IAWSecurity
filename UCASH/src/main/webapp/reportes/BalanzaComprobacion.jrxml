	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="431"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="555"/>
	<parameter name="idE" class="java.lang.Integer"/>
	<parameter name="perContFechaFin" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT idCuenta,
	numeroCuenta,
	nombreCuenta,
	rubro,
	naturalezaCta,
	fechaInicio,
	fechaFinal,
	sum( saldoInicial) AS saldoInicial,
	sum( debe) AS debe,
	sum( haber) AS haber,
	sum( saldoFinal) AS saldoFinal,
	idEmpresa,
	nombreComercial,
	ruc,
	url_logo,
	idCatalogo,
	estado
FROM vw_balanzacomprobacion
WHERE idEmpresa = $P{idE}  AND fechaFinal = $P{perContFechaFin}  AND estado <> 3
GROUP BY rubro 
ORDER BY numeroCuenta]]>
	</queryString>
